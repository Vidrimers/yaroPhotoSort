Windows Registry Editor Version 5.00

; Протокол yarophoto:// — запуск сервера yaroPhotoSort из index.html
; HKCU, админ не нужен.

[HKEY_CURRENT_USER\Software\Classes\yarophoto]
@="URL:YaroPhotoSort Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\yarophoto\shell]

[HKEY_CURRENT_USER\Software\Classes\yarophoto\shell\open]

[HKEY_CURRENT_USER\Software\Classes\yarophoto\shell\open\command]
@="C:\\Windows\\System32\\wscript.exe \"X:\\Programs\\AI\\yaroPhotoSort\\launch-hidden.vbs\" \"%1\""
