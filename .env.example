# yaroPhotoSort provider keys — copy to .env and fill in.
# .env is gitignored, do not commit real keys.

# LM Studio (local) needs no key
LMSTUDIO_URL=http://127.0.0.1:1234

# Ollama (local) needs no key
OLLAMA_URL=http://127.0.0.1:11434

# Google Colab (or any OpenAI-compatible tunnel)
COLAB_BASE_URL=
COLAB_API_KEY=

# ChatGPT / OpenAI
OPENAI_API_KEY=

# Claude / Anthropic
ANTHROPIC_API_KEY=

# Gemini / Google
GEMINI_API_KEY=

# Qwen / Alibaba DashScope
QWEN_API_KEY=

# MiMo / Xiaomi
MIMO_API_KEY=

# NVIDIA build.nvidia.com (NIM)
NVIDIA_API_KEY=

# OpenRouter (optional umbrella)
OPENROUTER_API_KEY=

# Optional base URL overrides
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# MIMO_BASE_URL=https://api.xiaomi.com/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api
