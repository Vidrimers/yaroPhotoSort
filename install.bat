@echo off
chcp 65001 >nul
setlocal EnableExtensions
cd /d "%~dp0"

set "ROOT=%CD%"
set "REGFILE=%ROOT%\register-yarophoto.reg"
set "VBS=%ROOT%\launch-hidden.vbs"

if not exist "%VBS%" (
    echo [!] launch-hidden.vbs not found in "%ROOT%"
    pause
    exit /b 1
)

echo Registering yarophoto:// protocol (HKCU, no admin)...
echo Project path: %ROOT%

> "%REGFILE%" (
    echo Windows Registry Editor Version 5.00
    echo.
    echo ; Generated by install.bat - do not edit, re-run install.bat after moving the project.
    echo.
    echo [HKEY_CURRENT_USER\Software\Classes\yarophoto]
    echo @="URL:YaroPhotoSort Protocol"
    echo "URL Protocol"=""
    echo.
    echo [HKEY_CURRENT_USER\Software\Classes\yarophoto\shell]
    echo.
    echo [HKEY_CURRENT_USER\Software\Classes\yarophoto\shell\open]
    echo.
    echo [HKEY_CURRENT_USER\Software\Classes\yarophoto\shell\open\command]
    echo @="C:\\Windows\\System32\\wscript.exe \"%VBS:\=\\%\" \"%%1\""
)

regedit /s "%REGFILE%"
if errorlevel 1 (
    echo [!] regedit failed. You can import manually: "%REGFILE%"
    pause
    exit /b 1
)

echo.
echo Done. Path baked into the protocol: %VBS%
echo Use the "Start server" button in index.html.
echo.
echo NOTE: if you move this folder later, run install.bat again.
pause
